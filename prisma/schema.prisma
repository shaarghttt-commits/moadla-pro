// Prisma schema for Moadla Pro Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  LINK
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  username      String?         @unique
  passwordHash  String
  role          String          @default("STUDENT") // STUDENT, ADMIN
  phone         String?
  bio           String?
  avatar        String?
  coverPhoto    String?
  department    String?
  yearOfStudy   String?
  seatNumber    String?         @unique // رقم الجلوس الرسمي للطالب في امتحانات المعادلة
  isOnline      Boolean         @default(false)
  lastSeenAt    DateTime        @default(now())
  isActive      Boolean         @default(true)
  gamePoints    Int             @default(0)
  gameWins      Int             @default(0)
  gameLosses    Int             @default(0)
  currentStreak Int             @default(1)
  longestStreak Int             @default(1)
  lastActiveDate DateTime?      @default(now())
  league        String          @default("BRONZE") // BRONZE, SILVER, GOLD, DIAMOND, MASTER
  weeklyXp      Int             @default(0)
  activeFrame   String?
  activeTitle   String?
  totalStudyMinutes Int         @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  attempts                  ExamAttempt[]
  progress                  LessonProgress[]
  favorites                 Favorite[]
  notifications             Notification[]
  logs                      ActivityLog[]
  friendRequestsSent        FriendRequest[]       @relation("FriendRequestsSent")
  friendRequestsReceived    FriendRequest[]       @relation("FriendRequestsReceived")
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]             @relation("SentMessages")
  messageReads              MessageRead[]
  attachments               MessageAttachment[]
  blocksInitiated           UserBlock[]           @relation("BlocksInitiated")
  blocksReceived            UserBlock[]           @relation("BlocksReceived")
  reportsMade               MessageReport[]       @relation("ReportsMade")
  reportedUsers             MessageReport[]       @relation("ReportedUsers")
  // Discussion relations
  discussionPosts           DiscussionPost[]
  discussionComments        DiscussionComment[]
  discussionLikes           DiscussionLike[]
  // Social Profile Wall relations
  authoredWallPosts         UserPost[]            @relation("UserAuthoredPosts")
  receivedWallPosts         UserPost[]            @relation("UserWallPosts")
  wallPostComments          UserPostComment[]
  wallPostLikes             UserPostLike[]
  // Groups relations
  groupsCreated             Group[]               @relation("GroupsCreated")
  groupMemberships          GroupMember[]
  groupPosts                GroupPost[]
  groupComments             GroupPostComment[]
  groupLikes                GroupPostLike[]
  // Games relations
  gameRoomsCreated          GameRoom[]            @relation("GameRoomsCreated")
  gameRoomsJoined           GameRoom[]            @relation("GameRoomsJoined")
  gameScores                GameScore[]
  // Stories relations
  stories                   Story[]
  storyViews                StoryView[]
  storyReactions            StoryReaction[]
  storyVotes                StoryVote[]
  // Rewards & Gamification relations
  rewards                   UserReward[]
  // Virtual Study Rooms relations
  studyRoomsCreated         StudyRoom[]           @relation("StudyRoomsCreated")
  studyRoomMemberships      StudyRoomMember[]
}

model FriendRequest {
  id         String               @id @default(cuid())
  senderId   String
  sender     User                 @relation("FriendRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                 @relation("FriendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus  @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser User     @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model Conversation {
  id             String                   @id @default(cuid())
  title          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  lastMessageAt  DateTime?

  participants   ConversationParticipant[]
  messages       Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  unreadCount    Int          @default(0)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id                String              @id @default(cuid())
  conversationId    String
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String
  sender            User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  type              MessageType         @default(TEXT)
  body              String?
  replyToId         String?
  replyTo           Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  deletedForSender  Boolean             @default(false)
  deletedForEveryone Boolean            @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  replies           Message[]           @relation("MessageReplies")
  attachments       MessageAttachment[]
  reads             MessageRead[]
  reports           MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  mimeType   String
  fileType   String
  fileSize   String?
  createdAt  DateTime @default(now())
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  reports    MessageReport[]
  @@index([messageId])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MessageReport {
  id            String   @id @default(cuid())
  reporterId    String
  reporter      User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId  String?
  targetUser    User?    @relation("ReportedUsers", fields: [targetUserId], references: [id], onDelete: SetNull)
  messageId     String?
  message       Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  attachmentId  String?
  attachment    MessageAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  reason        String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
}

model Section {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  icon        String?
  color       String?   @default("blue")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subjects    Subject[]
  exams       Exam[]
}

model Subject {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  image       String?
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  units       Unit[]
  exams       Exam[]
  files       LessonFile[]
}

model Unit {
  id          String    @id @default(cuid())
  title       String
  description String?
  order       Int       @default(0)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lessons     Lesson[]
  files       LessonFile[]
}

model Lesson {
  id              String           @id @default(cuid())
  title           String
  slug            String
  description     String?
  contentMarkdown String?
  videoUrl        String?
  thumbnail       String?
  durationMinutes Int              @default(15)
  order           Int              @default(0)
  isFree          Boolean          @default(true)
  isPublished     Boolean          @default(true)
  unitId          String
  unit            Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  files           LessonFile[]
  progress        LessonProgress[]
}

model LessonFile {
  id            String   @id @default(cuid())
  title         String
  fileUrl       String
  fileType      String   @default("pdf") // pdf, doc, zip, etc.
  fileSize      String?
  sourceUrl     String?
  sourceWebsite String?
  canonicalUrl  String?
  importedAt    DateTime?
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model CustomPage {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  coverImage      String?
  contentMarkdown String?
  blocksJson      String?   // JSON array of Page Builder blocks
  isPublished     Boolean   @default(true)
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  sourceUrl       String?
  sourceWebsite   String?
  canonicalUrl    String?
  importedAt      DateTime?
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MediaItem {
  id            String    @id @default(cuid())
  name          String
  url           String    @unique
  type          String    @default("image") // image, pdf, video, doc
  size          String?
  mimeType      String?
  dimensions    String?
  sourceUrl     String?
  sourceWebsite String?
  canonicalUrl  String?
  importedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model NavItem {
  id           String    @id @default(cuid())
  title        String
  href         String
  icon         String?
  order        Int       @default(0)
  isVisible    Boolean   @default(true)
  openInNewTab Boolean   @default(false)
  parentId     String?
  parent       NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavItem[] @relation("NavChildren")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model FooterColumn {
  id        String       @id @default(cuid())
  title     String
  order     Int          @default(0)
  isVisible Boolean      @default(true)
  links     FooterLink[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model FooterLink {
  id           String       @id @default(cuid())
  title        String
  href         String
  icon         String?
  order        Int          @default(0)
  isVisible    Boolean      @default(true)
  openInNewTab Boolean      @default(false)
  columnId     String
  column       FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Exam {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String?
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sectionId       String?
  section         Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  year            Int?          @default(2024)
  durationMinutes Int           @default(30)
  totalMarks      Int           @default(100)
  passMarks       Int           @default(50)
  isPublished     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  questions       Question[]
  attempts        ExamAttempt[]
}

model Question {
  id           String        @id @default(cuid())
  examId       String
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText String
  explanation  String?
  marks        Int           @default(1)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())

  choices      Choice[]
  answers      ExamAnswer[]
}

model Choice {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int           @default(0)

  answers    ExamAnswer[]
}

/// Discussion models for community forum
model DiscussionPost {
  id          String               @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  fileUrl     String?
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    DiscussionComment[]  
  likes       DiscussionLike[]
  isHidden    Boolean              @default(false)
  isPinned    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([authorId, createdAt])
}

model DiscussionComment {
  id          String               @id @default(cuid())
  postId      String
  post        DiscussionPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      DiscussionComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     DiscussionComment[]  @relation("CommentReplies")
  content     String
  isDeleted   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model DiscussionLike {
  id        String   @id @default(cuid())
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model ExamAttempt {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  score            Float
  totalPossible    Float
  percentage       Float
  isPassed         Boolean
  timeSpentSeconds Int          @default(0)
  completedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())

  answers          ExamAnswer[]
}

model ExamAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId String?
  selectedChoice   Choice?     @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)
  isCorrect        Boolean     @default(false)
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // SUBJECT, LESSON, EXAM
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime  @default(now())
}

/// Facebook-style Social Profile Wall & Feed
model UserPost {
  id           String            @id @default(cuid())
  authorId     String
  author       User              @relation("UserAuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?             @relation("UserWallPosts", fields: [targetUserId], references: [id], onDelete: Cascade)
  content      String
  imageUrl     String?
  imagesJson   String?           // JSON array of image URLs
  fileUrl      String?
  subjectTag   String?           // calculus, physics, mechanics, exams, general
  moodEmoji    String?           // feeling / activity
  isPinned     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  comments     UserPostComment[]
  likes        UserPostLike[]

  @@index([authorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([subjectTag, createdAt])
}

model UserPostComment {
  id        String            @id @default(cuid())
  postId    String
  post      UserPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  audioUrl  String?
  audioDuration Int?
  parentId  String?
  parent    UserPostComment?  @relation("UserPostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   UserPostComment[] @relation("UserPostCommentReplies")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model UserPostLike {
  id        String   @id @default(cuid())
  postId    String
  post      UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("LIKE") // LIKE, LOVE, WOW, LAUGH
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

/// Facebook/Instagram-Style 24-Hour Student Stories
model Story {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String          @default("TEXT") // TEXT, IMAGE, QUIZ, AUDIO
  content       String?
  mediaUrl      String?
  audioUrl      String?
  audioDuration Int?
  musicTitle    String?
  musicArtist   String?
  musicUrl      String?
  quizQuestion  String?
  quizOptions   String?         // JSON array of options: [{"id":"opt1","text":"...","isCorrect":true}]
  bgColor       String?         @default("from-blue-600 to-indigo-900")
  fontFamily    String?         @default("tajawal")
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  views         StoryView[]
  reactions     StoryReaction[]
  votes         StoryVote[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryVote {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("❤️") // ❤️, 🔥, 👏, 😂, 💡, 😮
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId])
}

/// Student Study Groups
model Group {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  coverImage  String?
  icon        String?
  category    String        @default("GENERAL") // ENGINEERING, COMMERCE, PHYSICS, MATH, GENERAL
  isPrivate   Boolean       @default(false)
  inviteCode  String?
  creatorId   String
  creator     User          @relation("GroupsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     GroupMember[]
  posts       GroupPost[]
  files       GroupFile[]

  @@index([category])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN, MODERATOR, MEMBER
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model GroupPost {
  id         String             @id @default(cuid())
  groupId    String
  group      Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String?
  content    String
  imageUrl   String?
  fileUrl    String?
  isPinned   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  comments   GroupPostComment[]
  likes      GroupPostLike[]

  @@index([groupId, createdAt])
  @@index([authorId, createdAt])
}

model GroupPostComment {
  id        String             @id @default(cuid())
  postId    String
  post      GroupPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    GroupPostComment?  @relation("GroupPostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   GroupPostComment[] @relation("GroupPostCommentReplies")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([postId, createdAt])
}

model GroupPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model GroupFile {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileSize   String?
  fileType   String   @default("pdf")
  uploaderId String?
  createdAt  DateTime @default(now())

  @@index([groupId])
}

/// Multiplayer & Interactive Games
model GameRoom {
  id            String   @id @default(cuid())
  code          String   @unique
  gameType      String   @default("DUEL") // DUEL, MEMORY, SPEED_MATH
  subject       String   @default("calculus")
  status        String   @default("WAITING") // WAITING, PLAYING, FINISHED, CANCELLED
  creatorId     String
  creator       User     @relation("GameRoomsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  opponentId    String?
  opponent      User?    @relation("GameRoomsJoined", fields: [opponentId], references: [id], onDelete: SetNull)
  winnerId      String?
  creatorScore  Int      @default(0)
  opponentScore Int      @default(0)
  questionsJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([status])
}

model GameScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType   String
  score      Int
  pointsWon  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, gameType])
  @@index([gameType, score])
}

/// User Rewards, Purchased Frames, Titles, Badges
model UserReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType  String   // FRAME, TITLE, BADGE, VIP_PDF
  rewardKey   String
  name        String
  cost        Int      @default(0)
  purchasedAt DateTime @default(now())

  @@unique([userId, rewardKey])
  @@index([userId])
}

/// Virtual Live Study Rooms (Pomodoro & Ambient)
model StudyRoom {
  id                String            @id @default(cuid())
  name              String
  description       String?
  topic             String            @default("general") // calculus, physics, mechanics, algebra, general
  creatorId         String
  creator           User              @relation("StudyRoomsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  isPrivate         Boolean           @default(false)
  passcode          String?
  activeTrack       String            @default("rain") // rain, library, lofi, ocean
  whiteboardData    String?           // JSON string of canvas strokes
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           StudyRoomMember[]

  @@index([creatorId])
  @@index([topic])
}

model StudyRoomMember {
  id           String    @id @default(cuid())
  roomId       String
  room         StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  minutesSpent Int       @default(0)
  isMuted      Boolean   @default(false)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}